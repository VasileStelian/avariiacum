{
  "name": "avariiacum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:smoke",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor,studio,postgres-meta"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "1.87.0",
    "playwright": "1.63.0",
    "postgres": "3.4.9",
    "supabase": "2.119.0",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
