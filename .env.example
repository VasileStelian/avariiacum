# Copiază în .env.local pentru dezvoltare. Valorile reale stau doar în variabilele de mediu Vercel.

# Supabase: URL-ul proiectului și cheia secretă (sb_secret_...). Doar pe server.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Cheie pentru amprenta HMAC a adreselor IP, minim 32 de caractere: openssl rand -hex 32
IP_HASH_SECRET=

# Secretul trimis de Vercel Cron în Authorization: Bearer <CRON_SECRET>, minim 32 de caractere
CRON_SECRET=
